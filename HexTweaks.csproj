<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>HexTweaks</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GameManaged>E:\SteamLibrary\steamapps\common\Risk of Rain 2\Risk of Rain 2_Data\Managed</GameManaged>
    <Profile>$(APPDATA)\r2modmanPlus-local\RiskOfRain2\profiles\VP\BepInEx</Profile>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx" HintPath="$(Profile)\core\BepInEx.dll" Private="false" />
    <Reference Include="MMHOOK_RoR2" HintPath="$(Profile)\plugins\MMHOOK\MMHOOK_RoR2.dll" Private="false" />
    <Reference Include="MonoMod.RuntimeDetour" HintPath="$(Profile)\core\MonoMod.RuntimeDetour.dll" Private="false" />
    <Reference Include="R2API.ContentManagement" HintPath="$(Profile)\plugins\RiskofThunder-R2API_ContentManagement\R2API.ContentManagement\R2API.ContentManagement.dll" Private="false" />
    <Reference Include="R2API.RecalculateStats" HintPath="$(Profile)\plugins\RiskofThunder-R2API_RecalculateStats\R2API.RecalculateStats\R2API.RecalculateStats.dll" Private="false" />
    <Reference Include="RoR2" HintPath="$(GameManaged)\RoR2.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(GameManaged)\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(GameManaged)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.ImageConversionModule" HintPath="$(GameManaged)\UnityEngine.ImageConversionModule.dll" Private="false" />
    <Reference Include="Unity.Addressables" HintPath="$(GameManaged)\Unity.Addressables.dll" Private="false" />
    <Reference Include="Unity.ResourceManager" HintPath="$(GameManaged)\Unity.ResourceManager.dll" Private="false" />
    <Reference Include="com.unity.multiplayer-hlapi.Runtime" HintPath="$(GameManaged)\com.unity.multiplayer-hlapi.Runtime.dll" Private="false" />
  </ItemGroup>

</Project>
